#!/usr/bin/env bash
set -euo pipefail

mkdir -p /var/lib/sato /etc/sato
echo "started $(date -Is)" > /var/lib/sato/bootstrap-state
CHECKPOINT_URL='{{CHECKPOINT_URL}}'
CHECKPOINT_TOKEN='{{CHECKPOINT_TOKEN}}'

send_checkpoint() {
  local event="$1"
  local detail="${2:-}"
  local tailscale_ip="${3:-}"
  curl -fsS -m 6 -X POST "$CHECKPOINT_URL" \
    --data-urlencode "token=$CHECKPOINT_TOKEN" \
    --data-urlencode "event=$event" \
    --data-urlencode "detail=$detail" \
    --data-urlencode "tailscaleIp=$tailscale_ip" >/dev/null 2>&1 || true
}

on_bootstrap_error() {
  local code="$1"
  local line="$2"
  echo "bootstrap.sh failed at line $line with exit code $code"
  send_checkpoint "bootstrap_failed" "unexpected_error_line_${line}_code_${code}"
  echo "failed $(date -Is) code=$code line=$line" > /var/lib/sato/bootstrap-state
  exit "$code"
}
trap 'on_bootstrap_error "$?" "$LINENO"' ERR

install_storage_prepare_script() {
  cat > /usr/local/sbin/sato-openclaw-storage.sh <<'EOF_HELPER'
#!/usr/bin/env bash
set -euo pipefail

ENCRYPTION_KEY_URL='{{ENCRYPTION_KEY_URL}}'
ENCRYPTION_USER_ID='{{ENCRYPTION_USER_ID}}'
ENCRYPTION_AUTH_SECRET='{{ENCRYPTION_AUTH_SECRET}}'
DATA_VOLUME_SIZE_GB='{{DATA_VOLUME_SIZE_GB}}'
DATA_IMAGE='/var/lib/sato/openclaw-data.img'
MAPPER_NAME='sato-openclaw-data'
MAPPER_PATH="/dev/mapper/${MAPPER_NAME}"
CREATED=0

create_unlock_signature() {
  local requested_at="$1"

  python3 - "$ENCRYPTION_AUTH_SECRET" "$ENCRYPTION_USER_ID" "$requested_at" <<'PY'
import base64
import hashlib
import hmac
import sys

secret, user_id, requested_at = sys.argv[1:4]
message = f"{user_id}:{requested_at}".encode("utf-8")
signature = hmac.new(secret.encode("utf-8"), message, hashlib.sha256).digest()
print(base64.urlsafe_b64encode(signature).decode("utf-8").rstrip("="))
PY
}

request_data_key() {
  local requested_at
  requested_at="$(date +%s)"
  local signature
  signature="$(create_unlock_signature "$requested_at")"

  local response
  response="$(curl -fsS -m 10 -X POST "$ENCRYPTION_KEY_URL" \
    -H 'Content-Type: application/json' \
    -d "{\"userId\":\"$ENCRYPTION_USER_ID\",\"requestedAt\":$requested_at,\"signature\":\"$signature\"}")"

  python3 -c 'import json,sys; payload=json.load(sys.stdin); print(payload.get("key", ""))' <<<"$response"
}

DATA_KEY="$(request_data_key)"
if [ -z "$DATA_KEY" ]; then
  echo "Failed to resolve data encryption key"
  exit 1
fi

if [ ! -f "$DATA_IMAGE" ]; then
  if ! fallocate -l "${DATA_VOLUME_SIZE_GB}G" "$DATA_IMAGE"; then
    truncate -s "${DATA_VOLUME_SIZE_GB}G" "$DATA_IMAGE"
  fi
  chmod 600 "$DATA_IMAGE"
  printf '%s' "$DATA_KEY" | cryptsetup luksFormat --batch-mode --type luks2 "$DATA_IMAGE" --key-file -
  CREATED=1
fi

if ! cryptsetup status "$MAPPER_NAME" >/dev/null 2>&1; then
  printf '%s' "$DATA_KEY" | cryptsetup luksOpen "$DATA_IMAGE" "$MAPPER_NAME" --key-file -
fi

if [ "$CREATED" -eq 1 ] || ! blkid "$MAPPER_PATH" >/dev/null 2>&1; then
  mkfs.ext4 -F "$MAPPER_PATH" >/dev/null
fi

mkdir -p /opt/openclaw
if ! mountpoint -q /opt/openclaw; then
  mount "$MAPPER_PATH" /opt/openclaw
fi

chown openclaw:openclaw /opt/openclaw
chmod 700 /opt/openclaw

unset DATA_KEY

echo "SATO_DATA_VOLUME_CREATED=$CREATED"
EOF_HELPER

  chmod 700 /usr/local/sbin/sato-openclaw-storage.sh
}

install_storage_systemd_unit() {
  cat > /etc/systemd/system/sato-openclaw-storage.service <<'UNIT'
[Unit]
Description=Sato OpenClaw encrypted storage preparation
After=network-online.target
Wants=network-online.target
Before=openclaw-gateway.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/sato-openclaw-storage.sh

[Install]
WantedBy=multi-user.target
UNIT

  mkdir -p /etc/systemd/system/openclaw-gateway.service.d
  cat > /etc/systemd/system/openclaw-gateway.service.d/storage.conf <<'UNIT'
[Unit]
Requires=sato-openclaw-storage.service
After=sato-openclaw-storage.service
UNIT

  systemctl daemon-reload
  systemctl enable sato-openclaw-storage
}

prepare_encrypted_storage() {
  local output=""

  if ! output="$(/usr/local/sbin/sato-openclaw-storage.sh 2>&1)"; then
    printf '%s\n' "$output"
    send_checkpoint "bootstrap_failed" "data_volume_unlock_failed"
    exit 1
  fi

  printf '%s\n' "$output"

  if printf '%s\n' "$output" | grep -q 'SATO_DATA_VOLUME_CREATED=1'; then
    send_checkpoint "data_volume_created" "data_volume_created"
  fi

  send_checkpoint "data_volume_unlocked" "data_volume_unlocked"
}

export HOME=/root
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export NO_COLOR=1
export CLICOLOR=0
export FORCE_COLOR=0
echo "bootstrap started at $(date -Is)"
echo "hostname: $(hostname)"
cloud-init status --long || true

# Load API key
if [ ! -f /etc/sato/openclaw.env ]; then
  send_checkpoint "bootstrap_failed" "openrouter_env_missing"
  exit 1
fi

set -a
source /etc/sato/openclaw.env
set +a

if [ -z "${OPENROUTER_API_KEY:-}" ]; then
  send_checkpoint "bootstrap_failed" "openrouter_key_missing"
  exit 1
fi

TS_IPV4=""
send_checkpoint "bootstrap_started" "bootstrap_started"

# Join Tailscale mesh (retry up to 3 times for transient DNS/network issues)
TS_JOINED=0
for TS_ATTEMPT in 1 2 3; do
  if tailscale up --ssh --authkey '{{TAILSCALE_AUTH_KEY}}' --hostname '{{TAILSCALE_HOSTNAME}}'; then
    TS_JOINED=1
    break
  fi
  echo "tailscale up attempt $TS_ATTEMPT failed, retrying in 10s..."
  sleep 10
done
if [ "$TS_JOINED" -ne 1 ]; then
  echo "Failed to join Tailscale after 3 attempts"
  send_checkpoint "bootstrap_failed" "tailscale_join_failed"
  exit 1
fi
TS_IPV4="$(tailscale ip -4 2>/dev/null | head -n 1 || true)"
send_checkpoint "tailscale_joined" "tailscale_joined" "$TS_IPV4"

systemctl stop openclaw-gateway 2>/dev/null || true

install_storage_prepare_script
install_storage_systemd_unit
prepare_encrypted_storage

# Configure OpenClaw as unprivileged user (already installed in snapshot)
if ! sudo -u openclaw env HOME=/opt/openclaw \
  PATH=/usr/local/bin:/usr/bin:/bin \
  NO_COLOR=1 CLICOLOR=0 FORCE_COLOR=0 \
  OPENROUTER_API_KEY="$OPENROUTER_API_KEY" \
  openclaw onboard --non-interactive --accept-risk --mode local \
  --auth-choice openrouter-api-key --openrouter-api-key "$OPENROUTER_API_KEY" \
  --gateway-port 18789 --gateway-bind loopback --skip-skills --skip-health; then
  send_checkpoint "bootstrap_failed" "openclaw_onboard_failed" "$TS_IPV4"
  exit 1
fi

# Enable chat completions endpoint + Tailscale auth bypass
if ! sudo -u openclaw env HOME=/opt/openclaw PATH=/usr/local/bin:/usr/bin:/bin \
  openclaw config set --json gateway.auth.allowTailscale true; then
  python3 -c "import json,os; p='/opt/openclaw/.openclaw/openclaw.json'; c=json.load(open(p)) if os.path.exists(p) else {}; c.setdefault('gateway',{}).setdefault('auth',{})['allowTailscale']=True; json.dump(c, open(p,'w'), indent=2)"
fi
if ! sudo -u openclaw env HOME=/opt/openclaw PATH=/usr/local/bin:/usr/bin:/bin \
  openclaw config set gateway.auth.token '{{OPENCLAW_GATEWAY_TOKEN}}'; then
  python3 -c "import json,os; p='/opt/openclaw/.openclaw/openclaw.json'; c=json.load(open(p)) if os.path.exists(p) else {}; c.setdefault('gateway',{}).setdefault('auth',{})['token']='{{OPENCLAW_GATEWAY_TOKEN}}'; json.dump(c, open(p,'w'), indent=2)"
fi
if ! sudo -u openclaw env HOME=/opt/openclaw PATH=/usr/local/bin:/usr/bin:/bin \
  openclaw config set --json gateway.http.endpoints.chatCompletions.enabled true; then
  python3 -c "import json,os; p='/opt/openclaw/.openclaw/openclaw.json'; c=json.load(open(p)) if os.path.exists(p) else {}; c.setdefault('gateway',{}).setdefault('http',{}).setdefault('endpoints',{}).setdefault('chatCompletions',{})['enabled']=True; json.dump(c, open(p,'w'), indent=2)"
fi
python3 -c "import json,os; p='/opt/openclaw/.openclaw/openclaw.json'; c=json.load(open(p)) if os.path.exists(p) else {}; c.pop('provider', None); json.dump(c, open(p,'w'), indent=2)" || true

# Set preferred AI model
if ! sudo -u openclaw env HOME=/opt/openclaw PATH=/usr/local/bin:/usr/bin:/bin \
  openclaw config set agents.defaults.model.primary '{{PREFERRED_MODEL}}'; then
  MODEL_VALUE='{{PREFERRED_MODEL}}' python3 -c "import json,os; p='/opt/openclaw/.openclaw/openclaw.json'; c=json.load(open(p)) if os.path.exists(p) else {}; c.setdefault('agents',{}).setdefault('defaults',{}).setdefault('model',{})['primary']=os.environ.get('MODEL_VALUE',''); json.dump(c, open(p,'w'), indent=2)"
fi
MODEL_VALUE='{{PREFERRED_MODEL}}' python3 - <<'PY'
import json, os
p = '/opt/openclaw/.openclaw/openclaw.json'
c = json.load(open(p)) if os.path.exists(p) else {}
d = c.setdefault('agents', {}).setdefault('defaults', {})
model = d.setdefault('model', {})
m = os.environ.get('MODEL_VALUE', '')
models = d.setdefault('models', {})
if m:
  models.setdefault(m, {})
if m.startswith('openrouter/') and m != 'openrouter/openrouter/auto' and not model.get('fallbacks'):
  models.setdefault('openrouter/openrouter/auto', {})
  model['fallbacks'] = ['openrouter/openrouter/auto']
json.dump(c, open(p, 'w'), indent=2)
PY

# Enable Telegram plugin
if ! sudo -u openclaw env HOME=/opt/openclaw PATH=/usr/local/bin:/usr/bin:/bin \
  NO_COLOR=1 CLICOLOR=0 FORCE_COLOR=0 \
  openclaw plugins enable telegram > /dev/null 2>&1; then
  echo "Failed to enable Telegram plugin"
  send_checkpoint "bootstrap_failed" "telegram_plugin_enable_failed" "$TS_IPV4"
  sudo -u openclaw env HOME=/opt/openclaw PATH=/usr/local/bin:/usr/bin:/bin \
    openclaw plugins list --json || true
  exit 1
fi

TELEGRAM_PLUGIN_LIST=$(sudo -u openclaw env HOME=/opt/openclaw PATH=/usr/local/bin:/usr/bin:/bin \
  NO_COLOR=1 CLICOLOR=0 FORCE_COLOR=0 \
  openclaw plugins list --enabled --json 2>/dev/null || true)
if ! printf '%s' "$TELEGRAM_PLUGIN_LIST" | grep -q '"id": "telegram"'; then
  echo "Telegram plugin is still not enabled after setup"
  send_checkpoint "bootstrap_failed" "telegram_plugin_missing_after_enable" "$TS_IPV4"
  printf '%s\n' "$TELEGRAM_PLUGIN_LIST"
  exit 1
fi

# Start the pre-baked gateway service
systemctl daemon-reload
systemctl start openclaw-gateway
systemctl is-active --quiet openclaw-gateway

# Wait for gateway to come up (fatal if it never binds)
echo "Waiting for gateway on port 18789..."
GATEWAY_READY=0
for i in $(seq 1 30); do
  if ss -tlnp | grep -q ':18789'; then
    echo "Gateway is ready on port 18789"
    GATEWAY_READY=1
    break
  fi
  sleep 2
done

if [ "$GATEWAY_READY" -ne 1 ]; then
  echo "Gateway failed to bind on port 18789"
  send_checkpoint "bootstrap_failed" "gateway_bind_failed" "$TS_IPV4"
  systemctl status openclaw-gateway --no-pager || true
  journalctl -u openclaw-gateway -n 200 --no-pager || true
  exit 1
fi

if ! tailscale serve --bg --yes --tcp 18789 127.0.0.1:18789; then
  echo "Failed to configure Tailscale Serve for gateway TCP forwarding"
  send_checkpoint "bootstrap_failed" "tailscale_serve_config_failed" "$TS_IPV4"
  exit 1
fi

SERVE_STATUS="$(tailscale serve status 2>/dev/null || true)"
if ! printf '%s\n' "$SERVE_STATUS" | grep -q '18789'; then
  echo "Tailscale Serve does not show expected gateway TCP forwarding on 18789"
  printf '%s\n' "$SERVE_STATUS"
  send_checkpoint "bootstrap_failed" "tailscale_serve_config_failed" "$TS_IPV4"
  exit 1
fi

send_checkpoint "gateway_ready" "gateway_ready" "$TS_IPV4"

# Lock SSH back to Tailscale-only after successful bootstrap
apply_ufw_rules() {
  ufw --force reset &&
    ufw default deny incoming &&
    ufw default allow outgoing &&
    ufw allow in on tailscale0 to any port 18789 proto tcp &&
    ufw allow in on tailscale0 to any port 22 proto tcp &&
    ufw --force enable
}

if command -v ufw >/dev/null 2>&1; then
  if ! apply_ufw_rules; then
    echo "WARNING: UFW hardening failed; continuing bootstrap"
    send_checkpoint "bootstrap_warning" "ufw_apply_failed" "$TS_IPV4"
  fi
else
  echo "WARNING: ufw not installed; skipping firewall hardening"
  send_checkpoint "bootstrap_warning" "ufw_missing" "$TS_IPV4"
fi

# Harden: clear bootstrap env file after OpenClaw onboarding
: > /etc/sato/openclaw.env

# Harden: block metadata endpoint to prevent API key leakage
iptables -A OUTPUT -d 169.254.169.254 -j DROP || true
echo "succeeded $(date -Is)" > /var/lib/sato/bootstrap-state
send_checkpoint "bootstrap_completed" "bootstrap_completed" "$TS_IPV4"

# Log diagnostic info regardless of outcome
systemctl status openclaw-gateway --no-pager || true
