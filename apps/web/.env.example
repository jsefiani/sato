# Database URL for PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sato"

# Better Auth configuration
BETTER_AUTH_SECRET="generate-a-secret-here" # Generate with: npx @better-auth/cli secret

GOOGLE_CLIENT_ID=<your-client-id>
GOOGLE_CLIENT_SECRET=<your-client-secret>

APP_URL="http://localhost:3001"
APP_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
# Optional dedicated secret for deterministic OpenClaw gateway tokens.
# If omitted, APP_ENCRYPTION_KEY is used.
# OPENCLAW_GATEWAY_TOKEN_SECRET=<your-gateway-token-secret>

OPENROUTER_PROVISIONING_KEY=<your-openrouter-provisioning-key>
TRIAL_INCLUDED_CREDITS=1500
MONTHLY_INCLUDED_CREDITS=12000

HETZNER_API_TOKEN=<your-hetzner-token>
HETZNER_SSH_KEY_ID=<your-hetzner-ssh-key-id>
# Debug only: temporarily open SSH(22) in per-VPS Hetzner firewalls
# HETZNER_DEBUG_ALLOW_PUBLIC_SSH=true
# Optional comma-separated CIDRs (default: 0.0.0.0/0,::/0)
# HETZNER_DEBUG_SSH_SOURCE_IPS=203.0.113.10/32,2001:db8::10/128

# SSH connection (Tailscale SSH handles authentication — no private keys needed)
VPS_SSH_USER=root
VPS_SSH_PORT=22
# Periodic orphan sweep (Hetzner resources labeled app=sato without DB ownership)
VPS_ORPHAN_SWEEP_ENABLED=true
VPS_ORPHAN_SWEEP_INTERVAL_MINUTES=30

# Tailscale mesh networking (control plane SSH routing)
TAILSCALE_API_KEY=<your-tailscale-api-key>

# Set to "false" to disable SSL for local dev (defaults to SSL enabled)
# DATABASE_SSL=false

# Hetzner snapshot ID with pre-baked OpenClaw (required). Build one with: bash web/scripts/build-snapshot.sh
# Debug snapshot build:
# SNAPSHOT_DEBUG_PUBLIC_SSH=true bash apps/web/scripts/build-snapshot.sh
HETZNER_SNAPSHOT_ID=<your-snapshot-id>

STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>
STRIPE_PRICE_ID=<your-subscription-price-id>
STRIPE_TOPUP_PACK_10_PRICE_ID=<your-topup-10-price-id>
STRIPE_TOPUP_PACK_25_PRICE_ID=<your-topup-25-price-id>
STRIPE_TOPUP_PACK_50_PRICE_ID=<your-topup-50-price-id>
