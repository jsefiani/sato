---
import Logo from './Logo.astro'
---

<footer class="py-12 px-6">
  <div class="mx-auto max-w-5xl">
    <div
      class="flex flex-col items-center gap-8 md:flex-row md:justify-between"
    >
      <div class="flex flex-col items-center gap-2 md:items-start">
        <Logo />
        <p class="mt-1 text-sm text-muted-foreground">
          Your private AI that knows you
        </p>
      </div>
      <div class="flex items-center gap-6 text-sm text-muted-foreground">
        <a href="/terms" class="transition-colors hover:text-foreground">
          Terms of Service
        </a>
        <a href="/privacy" class="transition-colors hover:text-foreground">
          Privacy Policy
        </a>
      </div>
    </div>
  </div>
</footer>
